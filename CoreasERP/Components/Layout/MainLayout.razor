@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager Navigation

<ErrorBoundary @ref="globalErrorBoundary">
    <ChildContent>
        @if (!AuthService.IsAuthenticated)
        {
            <Login />
        }
        else if (IsPosPage)
        {
            <!-- Modo Pantalla Completa Especial para Terminal POS -->
            <div class="pos-fullscreen-wrapper">
                <ErrorBoundary @ref="errorBoundaryPos">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="alert alert-danger m-4 p-4 shadow border-danger rounded-3 bg-white">
                            <h5 class="fw-bold text-danger mb-2">⚠️ Error en el Terminal POS</h5>
                            <p class="mb-2 text-dark">Ocurrió un error inesperado al renderizar el punto de venta:</p>
                            <div class="p-3 bg-dark text-white rounded font-monospace small mb-3" style="max-height: 250px; overflow-y: auto; white-space: pre-wrap;">
                                @ex.ToString()
                            </div>
                            <button class="btn btn-sm btn-primary px-3" @onclick="() => errorBoundaryPos?.Recover()">
                                Intentar Recuperar
                            </button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        }
        else
        {
            <div class="app-container">
                <!-- Desktop Sidebar (NavigationRail 220px) -->
                <aside class="sidebar">
                    <NavMenu />
                </aside>

                <!-- Main Content View -->
                <div class="main-area">
                    <!-- Mobile Topbar (< 800px) -->
                    <header class="mobile-topbar">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold fs-6">Coreas ERP</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="small badge bg-success">@(AuthService.CurrentUser?.NombreUsuario ?? "User")</span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="AuthService.Logout">Salir</button>
                        </div>
                    </header>

                    <!-- Main Scrollable Body -->
                    <main class="content-body">
                        <ErrorBoundary @ref="errorBoundary">
                            <ChildContent>
                                @Body
                            </ChildContent>
                            <ErrorContent Context="ex">
                                <div class="alert alert-danger m-4 p-4 shadow border-danger rounded-3 bg-white">
                                    <h5 class="fw-bold text-danger mb-2 d-flex align-items-center gap-2">
                                        <span>⚠️ Error al cargar la pantalla</span>
                                    </h5>
                                    <p class="mb-2 text-dark">Ocurrió una excepción al procesar esta sección del sistema:</p>
                                    <div class="p-3 bg-dark text-white rounded font-monospace small mb-3" style="max-height: 250px; overflow-y: auto; white-space: pre-wrap;">
                                        @ex.ToString()
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary px-3" @onclick="() => errorBoundary?.Recover()">
                                            Intentar Recuperar
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary px-3" @onclick='() => Navigation.NavigateTo("", replace: true)'>
                                            Ir al Inicio
                                        </button>
                                    </div>
                                </div>
                            </ErrorContent>
                        </ErrorBoundary>
                    </main>

                    <!-- Mobile Bottom Bar (< 800px) -->
                    <nav class="mobile-bottomnav">
                        @if (!AuthService.IsCajero)
                        {
                            <NavLink class="text-center text-decoration-none text-muted small py-1" href="" Match="NavLinkMatch.All">
                                <div>Inicio</div>
                            </NavLink>
                        }
                        <NavLink class="text-center text-decoration-none text-muted small py-1" href="pos">
                            <div>POS</div>
                        </NavLink>
                        @if (!AuthService.IsCajero)
                        {
                            <NavLink class="text-center text-decoration-none text-muted small py-1" href="inventario">
                                <div>Stock</div>
                            </NavLink>
                            <NavLink class="text-center text-decoration-none text-muted small py-1" href="ventas">
                                <div>Ventas</div>
                            </NavLink>
                        }
                    </nav>
                </div>
            </div>
        }
    </ChildContent>
    <ErrorContent Context="rootEx">
        <div class="p-4 m-4 alert alert-danger shadow-lg border-danger rounded-3 bg-white" style="max-width: 900px; margin: 40px auto !important;">
            <h4 class="fw-bold text-danger mb-2">⚠️ Error General en Coreas ERP</h4>
            <p class="text-dark">Se detectó una excepción en la interfaz principal:</p>
            <div class="p-3 bg-dark text-white rounded font-monospace small mb-3" style="max-height: 300px; overflow-y: auto; white-space: pre-wrap;">
                @rootEx.ToString()
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary px-4 fw-bold" @onclick="() => globalErrorBoundary?.Recover()">
                    Intentar Recuperar
                </button>
                <button class="btn btn-outline-secondary px-3" @onclick='() => Navigation.NavigateTo("", forceLoad: true)'>
                    Recargar Página
                </button>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? globalErrorBoundary;
    private ErrorBoundary? errorBoundary;
    private ErrorBoundary? errorBoundaryPos;

    private bool IsPosPage => Navigation.Uri.EndsWith("/pos", StringComparison.OrdinalIgnoreCase) || 
                              Navigation.Uri.Contains("/pos?", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += OnAuthChanged;
        Navigation.LocationChanged += OnLocationChanged;
        VerificarAccesoRol();
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(() =>
        {
            try
            {
                VerificarAccesoRol();
                StateHasChanged();
            }
            catch { }
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            try
            {
                globalErrorBoundary?.Recover();
                errorBoundary?.Recover();
                errorBoundaryPos?.Recover();
                VerificarAccesoRol();
                StateHasChanged();
            }
            catch { }
        });
    }

    private void VerificarAccesoRol()
    {
        if (AuthService.IsAuthenticated && AuthService.IsCajero && !IsPosPage)
        {
            Navigation.NavigateTo("pos", replace: true);
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
