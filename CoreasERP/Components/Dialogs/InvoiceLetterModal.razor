@inject IPrintService PrintService
@inject IJSRuntime JSRuntime
@inject IQrCodeService QrCodeService
@inject IDbContextFactory<AppDbContext> ContextFactory
@using CoreasERP.Data
@using Microsoft.EntityFrameworkCore

@if (IsOpen && Venta != null)
{
    <div class="modal-backdrop-custom" tabindex="-1" @onkeydown="HandleKeyDown" @onclick="Close">
        <div class="modal-content-custom" @onclick:stopPropagation="true" style="max-width: 940px; max-height: 94vh; display: flex; flex-direction: column;">
            <!-- Barra Superior de Acciones -->
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <div>
                        <h6 class="mb-0 fw-bold">@TituloDocumento — Formato Carta Oficial</h6>
                        <small class="text-muted">Vista previa de impresión oficial y guardado a PDF</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (OnImprimirTermico.HasDelegate)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3 fw-semibold" @onclick="EmitirTermico" title="Imprimir también ticket en rollo térmico">
                            Ticket Térmico
                        </button>
                    }
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm d-flex align-items-center gap-2" 
                            style="background-color: #15803D; border-color: #15803D;"
                            @onclick="ImprimirCarta" 
                            disabled="@isPrinting"
                            title="Imprimir en tamaño carta o guardar como PDF [Enter / F10]">
                        @if (isPrinting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Preparando...</span>
                        }
                        else
                        {
                            <span>Descargar PDF / Imprimir Carta</span>
                            <span class="badge bg-white text-success" style="font-size: 10px;">Enter / F10</span>
                        }
                    </button>
                    <button type="button" class="btn-close ms-2" @onclick="Close" title="Cerrar y continuar [Esc]"></button>
                </div>
            </div>

            <!-- Contenedor con Scroll para la Hoja Tamaño Carta -->
            <div class="p-4 bg-secondary bg-opacity-10" style="overflow-y: auto; flex: 1;">
                <!-- Hoja de Papel Tamaño Carta (8.5 x 11 in) -->
                <div id="letter-invoice" class="invoice-letter-container bg-white p-4 p-md-5 mx-auto shadow-sm" 
                     style="max-width: 820px; font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #1e293b; line-height: 1.4; border-radius: 4px;">

                    <!-- 1. ENCABEZADO Y CAJA FISCAL DTE -->
                    <div class="row g-3 mb-4 pb-3 border-bottom">
                        <!-- Datos del Emisor -->
                        <div class="col-7">
                            <h4 class="fw-bold mb-1" style="color: #15803D; letter-spacing: -0.5px;">
                                @(configNegocio?.NombreNegocio ?? "COREAS ERP")
                            </h4>
                            @if (!string.IsNullOrWhiteSpace(configNegocio?.Propietario))
                            {
                                <div class="fw-semibold text-dark">@configNegocio.Propietario</div>
                            }
                            <div class="text-muted small mt-1">
                                @if (!string.IsNullOrWhiteSpace(configNegocio?.Nit)) { <span><strong>NIT:</strong> @configNegocio.Nit &nbsp;|&nbsp; </span> }
                                @if (!string.IsNullOrWhiteSpace(configNegocio?.Nrc)) { <span><strong>NRC:</strong> @configNegocio.Nrc</span> }
                            </div>
                            <div class="text-muted small">
                                <strong>Giro:</strong> Comercio al por menor de productos diversos
                            </div>
                            @if (!string.IsNullOrWhiteSpace(configNegocio?.Direccion))
                            {
                                <div class="text-muted small"><strong>Dirección:</strong> @configNegocio.Direccion</div>
                            }
                            <div class="text-muted small">
                                @if (!string.IsNullOrWhiteSpace(configNegocio?.Telefono)) { <span><strong>Tel:</strong> @configNegocio.Telefono &nbsp;|&nbsp; </span> }
                                @if (!string.IsNullOrWhiteSpace(configNegocio?.Email)) { <span><strong>Email:</strong> @configNegocio.Email</span> }
                            </div>
                        </div>

                        <!-- Recuadro Oficial del Documento / DTE -->
                        <div class="col-5">
                            <div class="border rounded p-3 bg-light text-center h-100 d-flex flex-direction-column justify-content-center" 
                                 style="border-color: #cbd5e1 !important; border-width: 2px !important;">
                                <h6 class="fw-bold mb-1 text-uppercase text-dark" style="font-size: 13px; letter-spacing: 0.5px;">
                                    @TituloDocumento
                                </h6>
                                <div class="font-monospace fw-bold fs-6 text-success mb-2">
                                    @Venta.NumComprobante
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Venta.CodigoGeneracion))
                                {
                                    <div class="text-start small font-monospace pt-2 border-top border-secondary border-opacity-25" style="font-size: 9.5px;">
                                        <div><strong>CÓD. GENERACIÓN:</strong></div>
                                        <div class="text-break">@Venta.CodigoGeneracion</div>
                                        @if (!string.IsNullOrWhiteSpace(Venta.NumeroControl))
                                        {
                                            <div class="mt-1"><strong>NUM. CONTROL:</strong> @Venta.NumeroControl</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Venta.SelloRecepcion))
                                        {
                                            <div class="mt-1 text-truncate"><strong>SELLO MH:</strong> @Venta.SelloRecepcion</div>
                                        }
                                        <div class="mt-1">
                                            <strong>ESTADO:</strong> 
                                            <span class="badge @(Venta.EstadoDte == "Transmitido" ? "bg-success" : "bg-warning text-dark")">
                                                @(Venta.EstadoDte == "Transmitido" ? "TRANSMITIDO (MH)" : (Venta.EstadoDte ?? "PROCESADO"))
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-start small pt-2 border-top border-secondary border-opacity-25" style="font-size: 10px;">
                                        <div><strong>FECHA:</strong> @Venta.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</div>
                                        <div><strong>CAJERO:</strong> @(Venta.Usuario?.Nombre ?? "Cajero de Turno")</div>
                                        <div class="badge bg-secondary mt-1">Modo Local / Sin DTE</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 2. DATOS DEL CLIENTE / RECEPTOR -->
                    <div class="card border mb-4 bg-light bg-opacity-50" style="border-color: #e2e8f0;">
                        <div class="card-body p-3">
                            <div class="row g-2 small">
                                <div class="col-12 col-md-6">
                                    <div><strong>CLIENTE / RECEPTOR:</strong> @(Venta.Cliente?.Nombre ?? "Consumidor Final")</div>
                                    <div><strong>DOCUMENTO (DUI / NIT):</strong> @(Venta.Cliente?.NumDocumento ?? "00000000-0")</div>
                                    <div><strong>NRC:</strong> @(string.IsNullOrWhiteSpace(Venta.Cliente?.Nrc) ? "No Registra" : Venta.Cliente.Nrc)</div>
                                    <div><strong>GIRO / ACTIVIDAD:</strong> @(string.IsNullOrWhiteSpace(Venta.Cliente?.Giro) ? "Consumidor Final" : Venta.Cliente.Giro)</div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div><strong>DIRECCIÓN:</strong> @(string.IsNullOrWhiteSpace(Venta.Cliente?.Direccion) ? "San Miguel, El Salvador" : Venta.Cliente.Direccion)</div>
                                    <div><strong>TELÉFONO:</strong> @(string.IsNullOrWhiteSpace(Venta.Cliente?.Telefono) ? "-" : Venta.Cliente.Telefono)</div>
                                    <div><strong>CORREO:</strong> @(string.IsNullOrWhiteSpace(Venta.Cliente?.Email) ? "-" : Venta.Cliente.Email)</div>
                                    <div><strong>FORMA DE PAGO:</strong> Contado — @Venta.MetodoPago</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. DETALLE DE PRODUCTOS / ÍTEMS -->
                    <table class="table table-bordered mb-4" style="border-color: #cbd5e1; font-size: 11.5px;">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="width: 5%;">N°</th>
                                <th style="width: 8%;">CANT</th>
                                <th>DESCRIPCIÓN DEL PRODUCTO O SERVICIO</th>
                                <th style="width: 12%;">PRECIO UNIT.</th>
                                <th style="width: 12%;">NO SUJETAS</th>
                                <th style="width: 12%;">EXENTAS</th>
                                <th style="width: 14%;">VENTAS GRAVADAS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int itemIndex = 1;
                            }
                            @foreach (var item in Venta.DetalleVentas)
                            {
                                <tr>
                                    <td class="text-center text-muted">@itemIndex</td>
                                    <td class="text-center fw-bold">@item.Cantidad</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(item.Producto?.Nombre ?? "Producto")</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Producto?.Codigo))
                                        {
                                            <div class="text-muted font-monospace" style="font-size: 10px;">Cód: @item.Producto.Codigo</div>
                                        }
                                    </td>
                                    <td class="text-end font-monospace">$@item.Precio.ToString("F2")</td>
                                    <td class="text-end font-monospace text-muted">$0.00</td>
                                    <td class="text-end font-monospace text-muted">$0.00</td>
                                    <td class="text-end font-monospace fw-bold">$@item.Subtotal.ToString("F2")</td>
                                </tr>
                                itemIndex++;
                            }
                        </tbody>
                    </table>

                    <!-- 4. RESUMEN FINANCIERO Y CÓDIGO QR HACIENDA -->
                    <div class="row g-3 pt-2">
                        <!-- Columna Izquierda: Monto en letras y Código QR DTE -->
                        <div class="col-7 d-flex flex-column justify-content-between">
                            <div>
                                <div class="p-2 border rounded bg-light mb-3" style="font-size: 11px;">
                                    <strong>VALOR EN LETRAS:</strong><br />
                                    <span class="text-dark fw-bold">@NumeroALetrasHelper.Convertir(Venta.Total)</span>
                                </div>

                                @if (Venta.TipoComprobante.Equals("Anticipo", StringComparison.OrdinalIgnoreCase))
                                {
                                    decimal anticipo = Math.Min(Venta.PagoCon ?? 0m, Venta.Total);
                                    decimal saldo = Math.Max(0m, Venta.Total - anticipo);
                                    <div class="alert alert-info py-2 px-3 small mb-2">
                                        <div><strong>ANTICIPO ABONADO:</strong> $@anticipo.ToString("F2")</div>
                                        <div><strong>SALDO PENDIENTE:</strong> $@saldo.ToString("F2")</div>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(qrCodeBase64))
                            {
                                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-light">
                                    <img src="@qrCodeBase64" style="width: 105px; height: 105px; display: block;" alt="Código QR Hacienda" />
                                    <div class="small" style="font-size: 10px; line-height: 1.3;">
                                        <div class="fw-bold text-dark">CONSULTA PÚBLICA DTE</div>
                                        <div class="text-muted">Documento Tributario Electrónico emitido con firma digital autorizada por el Ministerio de Hacienda de El Salvador.</div>
                                        <div class="text-muted mt-1">Escanee este código con su teléfono celular para verificar su autenticidad.</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small fst-italic">
                                    Documento comprobante emitido por el sistema Coreas ERP.
                                </div>
                            }
                        </div>

                        <!-- Columna Derecha: Cuadro de Totales -->
                        <div class="col-5">
                            <table class="table table-bordered mb-0" style="font-size: 11.5px; border-color: #cbd5e1;">
                                <tbody>
                                    <tr>
                                        <td class="bg-light fw-semibold">SUMA VENTAS GRAVADAS:</td>
                                        <td class="text-end font-monospace">$@Venta.Subtotal.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td class="bg-light fw-semibold">VENTAS NO SUJETAS:</td>
                                        <td class="text-end font-monospace text-muted">$0.00</td>
                                    </tr>
                                    <tr>
                                        <td class="bg-light fw-semibold">VENTAS EXENTAS:</td>
                                        <td class="text-end font-monospace text-muted">$0.00</td>
                                    </tr>
                                    <tr>
                                        <td class="bg-light fw-semibold">SUBTOTAL:</td>
                                        <td class="text-end font-monospace fw-semibold">$@Venta.Subtotal.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td class="bg-light fw-semibold">IVA (13%):</td>
                                        <td class="text-end font-monospace">$@Venta.Impuesto.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td class="bg-light fw-semibold">IVA RETENIDO (1%):</td>
                                        <td class="text-end font-monospace text-muted">$0.00</td>
                                    </tr>
                                    <tr style="border-top: 2px solid #15803D;">
                                        <td class="fw-bold text-dark fs-6" style="background-color: #f0fdf4;">TOTAL A PAGAR:</td>
                                        <td class="text-end font-monospace fw-bold fs-6" style="background-color: #f0fdf4; color: #15803D;">$@Venta.Total.ToString("F2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 5. PIE DE PÁGINA -->
                    <div class="text-center small text-muted border-top mt-4 pt-3" style="font-size: 10px;">
                        <div>@(string.IsNullOrWhiteSpace(configNegocio?.MensajeTicket) ? "¡Gracias por su preferencia!" : configNegocio.MensajeTicket)</div>
                        <div class="mt-1">Software: Coreas ERP Local · Versión Windows x64</div>
                    </div>
                </div>
            </div>

            <!-- Pie de Botones -->
            <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="Close">
                    Volver al POS [Esc]
                </button>

                <div class="d-flex align-items-center gap-2">
                    @if (OnImprimirTermico.HasDelegate)
                    {
                        <button type="button" class="btn btn-outline-success btn-sm px-3" @onclick="EmitirTermico">
                            Imprimir Ticket Térmico
                        </button>
                    }
                    <button type="button" 
                            class="btn text-white btn-sm px-4 fw-bold shadow-sm" 
                            style="background-color: #15803D; border-color: #15803D;"
                            @onclick="ImprimirCarta" 
                            disabled="@isPrinting">
                        @if (isPrinting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Generando...</span>
                        }
                        else
                        {
                            <span>Descargar PDF / Imprimir [Enter / F10]</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Venta? Venta { get; set; }
    [Parameter] public EventCallback<Venta> OnImprimirTermico { get; set; }
    [Parameter] public EventCallback OnNuevaVenta { get; set; }

    private ConfiguracionNegocio? configNegocio;
    private string? qrCodeBase64;
    private bool isPrinting;

    private string TituloDocumento => Venta?.TipoComprobante switch
    {
        "CCF (03)" or "Credito Fiscal" => "COMPROBANTE DE CRÉDITO FISCAL",
        "Factura" => "FACTURA ELECTRÓNICA",
        "N.Remisión (04)" => "NOTA DE REMISIÓN",
        "N.Crédito (05)" => "NOTA DE CRÉDITO",
        "N.Débito (06)" => "NOTA DE DÉBITO",
        "Suj.Excluido (14)" => "FACTURA DE SUJETO EXCLUIDO",
        "Cotización" => "COTIZACIÓN COMERCIAL",
        "Anticipo" => "COMPROBANTE DE ANTICIPO",
        _ => "DOCUMENTO TRIBUTARIO ELECTRÓNICO"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Venta != null)
        {
            try
            {
                await using var context = await ContextFactory.CreateDbContextAsync();
                configNegocio = await context.ConfiguracionNegocio.FirstOrDefaultAsync();
            }
            catch { }

            string ambiente = configNegocio?.FelSvAmbiente ?? "00";

            if (!string.IsNullOrWhiteSpace(Venta.CodigoGeneracion))
            {
                qrCodeBase64 = QrCodeService.GenerarQrDteHacienda(Venta.CodigoGeneracion, Venta.FechaHora, ambiente, pixelsPerModule: 4);
            }
            else
            {
                qrCodeBase64 = null;
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "F10")
        {
            await ImprimirCarta();
        }
        else if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task ImprimirCarta()
    {
        if (isPrinting) return;
        isPrinting = true;
        try
        {
            await PrintService.PrintInvoiceLetterAsync(JSRuntime, "letter-invoice");
        }
        finally
        {
            isPrinting = false;
        }
    }

    private async Task EmitirTermico()
    {
        if (Venta != null && OnImprimirTermico.HasDelegate)
        {
            await OnImprimirTermico.InvokeAsync(Venta);
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        await OnNuevaVenta.InvokeAsync();
    }
}
