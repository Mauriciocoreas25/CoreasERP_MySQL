@inject IPromotionService PromotionService
@inject IProductService ProductService

@if (IsOpen)
{
    <div class="modal-backdrop-custom" @onclick="Close">
        <div class="modal-content-custom" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                    <h6 class="mb-0 fw-bold">@(Model.IdPromocion == 0 ? "Nueva Promoción u Oferta" : "Editar Promoción")</h6>
                </div>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <div class="p-4">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Nombre de la Promoción *</label>
                    <input type="text" class="form-control form-control-sm" @bind="Model.Nombre" placeholder="Ej. Descuento 10% Fin de Semana" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Descripción (Opcional)</label>
                    <input type="text" class="form-control form-control-sm" @bind="Model.Descripcion" placeholder="Condiciones o alcance de la promoción" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Tipo de Descuento</label>
                        <select class="form-select form-select-sm" @bind="Model.TipoDescuento">
                            <option value="Porcentaje">Porcentaje (%)</option>
                            <option value="Fijo">Monto Fijo ($)</option>
                        </select>
                    </div>

                    <div class="col-6">
                        <label class="form-label small fw-semibold">
                            @(Model.TipoDescuento == "Porcentaje" ? "Porcentaje (%) *" : "Monto de Descuento ($) *")
                        </label>
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm fw-bold" @bind="Model.Valor" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Fecha Inicio</label>
                        <input type="date" class="form-control form-control-sm" @bind="Model.FechaInicio" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Fecha Fin</label>
                        <input type="date" class="form-control form-control-sm" @bind="Model.FechaFin" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Aplica a Producto Específico (Opcional)</label>
                    <select class="form-select form-select-sm" @bind="Model.IdProducto">
                        <option value="0">-- Aplica a Todo el Catálogo / General --</option>
                        @foreach (var prod in Productos)
                        {
                            <option value="@prod.IdProducto">@prod.Nombre (@prod.Codigo)</option>
                        }
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger py-2 small mb-0">
                        @ErrorMessage
                    </div>
                }
            </div>

            <div class="p-3 border-top bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close" disabled="@isSaving">Cancelar</button>
                <button type="button" class="btn text-white btn-sm px-3" style="background-color: #15803D; border-color: #15803D;" @onclick="Guardar" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Promoción</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Promocion? PromocionEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private Promocion Model = new();
    private List<Producto> Productos = new();
    private bool isSaving;
    private string? ErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            Productos = await ProductService.GetAllAsync();
            ErrorMessage = null;
            isSaving = false;

            if (PromocionEdit != null && PromocionEdit.IdPromocion > 0)
            {
                Model = new Promocion
                {
                    IdPromocion = PromocionEdit.IdPromocion,
                    Nombre = PromocionEdit.Nombre,
                    Descripcion = PromocionEdit.Descripcion,
                    TipoDescuento = PromocionEdit.TipoDescuento,
                    Valor = PromocionEdit.Valor,
                    FechaInicio = PromocionEdit.FechaInicio,
                    FechaFin = PromocionEdit.FechaFin,
                    Estado = PromocionEdit.Estado,
                    IdProducto = PromocionEdit.IdProducto
                };
            }
            else
            {
                Model = new Promocion
                {
                    FechaInicio = DateTime.Today,
                    FechaFin = DateTime.Today.AddMonths(1),
                    TipoDescuento = "Porcentaje",
                    Valor = 10.00m,
                    Estado = true
                };
            }
        }
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(Model.Nombre))
        {
            ErrorMessage = "El nombre de la promoción es requerido.";
            return;
        }
        if (Model.Valor <= 0)
        {
            ErrorMessage = "El valor del descuento debe ser mayor a cero.";
            return;
        }

        isSaving = true;
        ErrorMessage = null;

        var result = await PromotionService.SaveAsync(Model);
        isSaving = false;

        if (result.Success)
        {
            await Close();
            await OnSaved.InvokeAsync();
        }
        else
        {
            ErrorMessage = result.Message;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
