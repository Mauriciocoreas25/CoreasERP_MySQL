@inject IAuthService AuthService

@if (IsOpen)
{
    <div class="modal-backdrop-custom" style="z-index: 1150;" @onclick="Cancelar">
        <div class="modal-content-custom" @onclick:stopPropagation="true" style="max-width: 480px;">
            <!-- Encabezado -->
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center text-white"
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <div class="d-flex align-items-center gap-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <div>
                        <h6 class="mb-0 fw-bold text-white">@(Titulo ?? "Autorización Requerida")</h6>
                        <small class="text-white-50" style="font-size: 11px;">
                            Seguridad de Caja: Supervisión Administrativa
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="Cancelar" title="Cerrar (Esc)"></button>
            </div>

            <div class="p-4 bg-white">
                <!-- Tarjeta informativa de la operación -->
                <div class="p-3 bg-light border rounded-3 mb-3">
                    <div class="small text-muted mb-1">Operación Solicitada:</div>
                    <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                        <span class="badge @(BadgeColor ?? "bg-dark") px-2 py-1">@OperacionNombre</span>
                    </div>
                    <div class="small text-muted mt-2 pt-2 border-top">
                        Cajero en turno: <strong>@(AuthService.CurrentUser?.Nombre ?? "Cajero")</strong>
                    </div>
                </div>

                <!-- Credenciales del Administrador / Supervisor -->
                <div class="card bg-light border p-3 rounded-3 mb-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1" style="font-size: 11px;">Seguridad</span>
                        <span class="fw-bold small text-dark">Credenciales de Administrador o Supervisor</span>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1">Usuario Autorizador *</label>
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Ej. admin"
                               @bind="adminUsername" @bind:event="oninput" autofocus />
                    </div>

                    <div>
                        <label class="form-label small fw-semibold mb-1">Contraseña de Autorización *</label>
                        <input type="password" class="form-control form-control-sm"
                               placeholder="••••••"
                               @bind="adminPassword" @bind:event="oninput"
                               @onkeydown="HandleKeyDown" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger py-2 small mb-0 d-flex align-items-center gap-2">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>@ErrorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(SuccessMessage))
                {
                    <div class="alert alert-success py-2 small mb-0 d-flex align-items-center gap-2">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>@SuccessMessage</span>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="p-3 border-top bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancelar" disabled="@isProcessing">
                    Cancelar
                </button>
                <button type="button" class="btn text-white btn-sm px-3 shadow-sm d-flex align-items-center gap-1"
                        style="background-color: #15803d; border-color: #15803d;"
                        @onclick="VerificarYAutorizar" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Verificando...</span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Autorizar Operación</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = "Autorización de Supervisor";
    [Parameter] public string OperacionNombre { get; set; } = "Operación de Caja";
    [Parameter] public string? BadgeColor { get; set; } = "bg-primary";
    [Parameter] public EventCallback<Usuario> OnAuthorized { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string adminUsername = "";
    private string adminPassword = "";
    private bool isProcessing = false;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            // Si el usuario en sesión es administrador, pre-cargar su nombre de usuario
            if (AuthService.IsAdmin && AuthService.CurrentUser != null)
            {
                adminUsername = AuthService.CurrentUser.NombreUsuario;
            }
            else
            {
                adminUsername = "";
            }
            adminPassword = "";
            ErrorMessage = null;
            SuccessMessage = null;
            isProcessing = false;
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerificarYAutorizar();
        }
        else if (e.Key == "Escape")
        {
            await Cancelar();
        }
    }

    private async Task VerificarYAutorizar()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrWhiteSpace(adminUsername) || string.IsNullOrWhiteSpace(adminPassword))
        {
            ErrorMessage = "Debe ingresar el usuario y la contraseña del Administrador o Supervisor.";
            return;
        }

        isProcessing = true;
        try
        {
            var res = await AuthService.VerifySupervisorOrAdminCredentialsAsync(adminUsername, adminPassword);
            if (!res.Success || res.SupervisorUser == null)
            {
                ErrorMessage = res.Message;
                isProcessing = false;
                return;
            }

            SuccessMessage = $"Operación autorizada correctamente por {res.SupervisorUser.Nombre}.";
            StateHasChanged();
            await Task.Delay(350);

            await CerrarModal();
            await OnAuthorized.InvokeAsync(res.SupervisorUser);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error de validación: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task Cancelar()
    {
        await CerrarModal();
        await OnCancel.InvokeAsync();
    }

    private async Task CerrarModal()
    {
        IsOpen = false;
        _wasOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
