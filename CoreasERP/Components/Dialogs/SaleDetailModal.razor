@inject IPosService PosService
@inject IQrCodeService QrCodeService
@inject IPrintService PrintService
@inject IDbContextFactory<AppDbContext> ContextFactory
@using CoreasERP.Data
@using Microsoft.EntityFrameworkCore

@if (IsOpen && Venta != null)
{
    <div class="modal-backdrop-custom" @onclick="Close">
        <div class="modal-content-custom large" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <h6 class="mb-0 fw-bold">Detalle de Comprobante @Venta.NumComprobante</h6>
                </div>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <div class="p-4">
                <!-- Información General de la Venta -->
                <div class="row g-3 mb-3 p-3 bg-light rounded-3 small">
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Fecha y Hora:</span>
                        <strong class="text-dark">@Venta.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</strong>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Cliente:</span>
                        <strong class="text-dark">@(Venta.Cliente?.Nombre ?? "Consumidor Final")</strong>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Cajero:</span>
                        <strong class="text-dark">@(Venta.Usuario?.Nombre ?? "-")</strong>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Estado:</span>
                        <span class="badge @(Venta.Estado == "Completada" ? "badge-completed" : "badge-cancelled")">
                            @Venta.Estado
                        </span>
                    </div>
                </div>

                <!-- Tabla de Artículos Vendidos -->
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Cant.</th>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th class="text-end">Precio Unit.</th>
                                <th class="text-end">Descuento</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Venta.DetalleVentas)
                            {
                                <tr>
                                    <td class="fw-bold text-center">@d.Cantidad</td>
                                    <td class="font-monospace text-muted">@(d.Producto?.Codigo ?? "-")</td>
                                    <td>@(d.Producto?.Nombre ?? "Producto")</td>
                                    <td class="text-end">$@d.Precio.ToString("F2")</td>
                                    <td class="text-end text-muted">$@d.Descuento.ToString("F2")</td>
                                    <td class="text-end fw-bold">$@d.Subtotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end fw-semibold">Subtotal:</td>
                                <td class="text-end">$@Venta.Subtotal.ToString("F2")</td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-end fw-semibold">IVA (13%):</td>
                                <td class="text-end">$@Venta.Impuesto.ToString("F2")</td>
                            </tr>
                            <tr class="fs-6">
                                <td colspan="5" class="text-end fw-bold" style="color: #15803D;">TOTAL:</td>
                                <td class="text-end fw-bold" style="color: #15803D;">$@Venta.Total.ToString("F2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Información DTE Ministerio de Hacienda -->
                @if (!string.IsNullOrEmpty(Venta.CodigoGeneracion))
                {
                    <div class="card border-0 shadow-sm rounded-3 mb-3" style="background-color: #f8fafc; border-left: 4px solid #15803D !important;">
                        <div class="card-body p-3">
                            <div class="row align-items-center">
                                <div class="col-md-9">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge" style="background-color: #15803D;">DTE HACIENDA</span>
                                        <span class="badge @(Venta.EstadoDte == "Transmitido" ? "bg-success" : (Venta.EstadoDte == "Contingencia_Pendiente" ? "bg-warning text-dark" : "bg-secondary"))">
                                            @(Venta.EstadoDte == "Transmitido" ? "TRANSMITIDO (MH)" : (Venta.EstadoDte == "Contingencia_Pendiente" ? "CONTINGENCIA" : Venta.EstadoDte))
                                        </span>
                                    </div>
                                    <div class="small mb-1">
                                        <span class="text-muted">Cód. Generación: </span>
                                        <strong class="font-monospace text-dark">@Venta.CodigoGeneracion</strong>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Venta.NumeroControl))
                                    {
                                        <div class="small mb-1">
                                            <span class="text-muted">Núm. Control: </span>
                                            <strong class="font-monospace text-dark">@Venta.NumeroControl</strong>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Venta.SelloRecepcion))
                                    {
                                        <div class="small mb-1">
                                            <span class="text-muted">Sello Recepción MH: </span>
                                            <strong class="font-monospace text-dark">@Venta.SelloRecepcion</strong>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(qrConsultaUrl))
                                    {
                                        <div class="mt-2">
                                            <a href="@qrConsultaUrl" target="_blank" class="btn btn-sm btn-outline-success py-1 px-3 fw-semibold" style="font-size: 11px;">
                                                Consultar en Portal Hacienda
                                            </a>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(qrCodeBase64))
                                {
                                    <div class="col-md-3 text-center border-start">
                                        <img src="@qrCodeBase64" style="width: 100px; height: 100px; display: block; margin: 0 auto;" alt="Código QR Hacienda" />
                                        <div class="text-muted mt-1" style="font-size: 9px;">Código QR MH</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (isConfirmingCancel)
                {
                    <div class="alert alert-danger p-3 mb-0">
                        <h6 class="fw-bold mb-1">¿Está seguro de anular la venta @Venta.NumComprobante?</h6>
                        <p class="small mb-3">
                            Esta acción devolverá automáticamente todas las unidades al inventario y marcará el ticket como Anulado.
                        </p>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => isConfirmingCancel = false" disabled="@isProcessing">
                                Cancelar
                            </button>
                            <button class="btn btn-sm btn-danger fw-bold" @onclick="AnularVenta" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Anulando...</span>
                                }
                                else
                                {
                                    <span>Sí, Anular y Devolver Stock</span>
                                }
                            </button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger py-2 small mt-2 mb-0">
                        @ErrorMessage
                    </div>
                }
            </div>

            <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Cerrar</button>
                <div class="d-flex gap-2">
                    @if (OnVerCarta.HasDelegate && Venta != null)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" @onclick="VerCarta" title="Ver documento en formato carta oficial o guardar como PDF">
                            Ver / Imprimir Carta (PDF)
                        </button>
                    }
                    @if (Venta?.Estado == "Anulada")
                    {
                        <button type="button" class="btn btn-warning btn-sm fw-bold shadow-sm d-flex align-items-center gap-1" 
                                @onclick="ImprimirDevolucion" disabled="@isPrintingDevolucion" title="Imprimir o reimprimir comprobante de devolución">
                            @if (isPrintingDevolucion)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Imprimiendo...</span>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                <span>Imprimir Ticket de Devolución</span>
                            }
                        </button>
                    }
                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="Reimprimir">
                        Reimprimir Ticket
                    </button>
                    @if (Venta?.Estado == "Completada" && !isConfirmingCancel)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => isConfirmingCancel = true">
                            Anular Venta
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Venta? Venta { get; set; }
    [Parameter] public EventCallback<Venta> OnReimprimir { get; set; }
    [Parameter] public EventCallback<Venta> OnVerCarta { get; set; }
    [Parameter] public EventCallback OnAnulada { get; set; }

    private bool isConfirmingCancel;
    private bool isProcessing;
    private bool isPrintingDevolucion;
    private string? ErrorMessage;
    private string? qrCodeBase64;
    private string? qrConsultaUrl;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            isConfirmingCancel = false;
            ErrorMessage = null;
            isProcessing = false;
            isPrintingDevolucion = false;

            if (Venta != null && !string.IsNullOrWhiteSpace(Venta.CodigoGeneracion))
            {
                string ambiente = "00";
                try
                {
                    await using var ctx = await ContextFactory.CreateDbContextAsync();
                    var cfg = await ctx.ConfiguracionNegocio.FirstOrDefaultAsync();
                    ambiente = cfg?.FelSvAmbiente ?? "00";
                }
                catch { }

                qrConsultaUrl = QrCodeService.ObtenerUrlConsultaHacienda(Venta.CodigoGeneracion, Venta.FechaHora, ambiente);
                qrCodeBase64 = QrCodeService.GenerarQrDteHacienda(Venta.CodigoGeneracion, Venta.FechaHora, ambiente, pixelsPerModule: 3);
            }
            else
            {
                qrCodeBase64 = null;
                qrConsultaUrl = null;
            }
        }
    }

    private async Task VerCarta()
    {
        if (Venta != null && OnVerCarta.HasDelegate)
        {
            await Close();
            await OnVerCarta.InvokeAsync(Venta);
        }
    }

    private async Task Reimprimir()
    {
        if (Venta != null)
        {
            await OnReimprimir.InvokeAsync(Venta);
        }
    }

    private async Task ImprimirDevolucion()
    {
        if (Venta == null) return;
        isPrintingDevolucion = true;
        ErrorMessage = null;
        try
        {
            await using var ctx = await ContextFactory.CreateDbContextAsync();
            var cfg = await ctx.ConfiguracionNegocio.FirstOrDefaultAsync();
            var res = await PrintService.PrintDevolucionDirectAsync(Venta, cfg);
            if (!res.Success)
            {
                ErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al imprimir devolución: {ex.Message}";
        }
        finally
        {
            isPrintingDevolucion = false;
            StateHasChanged();
        }
    }

    private async Task AnularVenta()
    {
        if (Venta == null) return;

        isProcessing = true;
        ErrorMessage = null;

        var result = await PosService.AnularVentaAsync(Venta.IdVenta);
        isProcessing = false;

        if (result.Success)
        {
            Venta.Estado = "Anulada";
            isConfirmingCancel = false;

            // Disparo automático de impresión del comprobante de devolución
            _ = Task.Run(async () =>
            {
                try
                {
                    await using var ctx = await ContextFactory.CreateDbContextAsync();
                    var cfg = await ctx.ConfiguracionNegocio.FirstOrDefaultAsync();
                    await PrintService.PrintDevolucionDirectAsync(Venta, cfg);
                }
                catch { }
            });

            await OnAnulada.InvokeAsync();
        }
        else
        {
            ErrorMessage = result.Message;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
