@page "/login"
@inject IAuthService AuthService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<div class="d-flex justify-content-center align-items-center vh-100 bg-light position-relative">
    <!-- Botón de Configuración SQL Superior -->
    <button type="button" 
            class="btn btn-outline-secondary btn-sm position-absolute top-0 end-0 m-3 d-flex align-items-center gap-1 shadow-sm"
            @onclick="() => isConfigOpen = true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span class="d-none d-sm-inline">Servidor SQL</span>
    </button>

    <div class="card border-0 shadow-lg p-4 p-sm-5" style="max-width: 440px; width: 90%; border-radius: 16px;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" 
                 style="width: 64px; height: 64px; background-color: #14532D; color: white;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </div>
            <h3 class="fw-bold mb-1">Coreas ERP</h3>
            <p class="text-muted small">Sistema de Almacén, Inventario & POS</p>
        </div>

        @if (isInitializingDb)
        {
            <div class="alert alert-info py-2 small d-flex align-items-center gap-2 mb-3">
                <span class="spinner-border spinner-border-sm"></span>
                <span>Verificando base de datos en SQL Server...</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
                <span>@ErrorMessage</span>
            </div>
        }

        <form @onsubmit="IniciarSesion">
            <div class="mb-3">
                <label class="form-label small fw-semibold">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </span>
                    <input type="text" class="form-control" @bind="Usuario" placeholder="Ej. admin" required autofocus />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span>
                    <input type="@(ShowPassword ? "text" : "password")" class="form-control" @bind="Clave" placeholder="••••••••" required />
                    <button class="btn btn-outline-secondary small text-muted" type="button" @onclick="() => ShowPassword = !ShowPassword" style="font-size: 11px;">
                        @(ShowPassword ? "Ocultar" : "Mostrar")
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-semibold mb-4" style="background-color: #15803d; border-color: #15803d;" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Conectando...</span>
                }
                else
                {
                    <span>Iniciar Sesión</span>
                }
            </button>
        </form>

    </div>
</div>

<DbConfigModal @bind-IsOpen="isConfigOpen" OnSaved="OnConfigSaved" />

@code {
    private string Usuario = "";
    private string Clave = "";
    private bool ShowPassword;
    private bool isLoading;
    private bool isInitializingDb;
    private bool isConfigOpen;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await InitializeDatabaseIfNeeded();
    }

    private async Task InitializeDatabaseIfNeeded()
    {
        isInitializingDb = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            await DbInitializer.InitializeAsync(context);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Aviso de conexión: {ex.Message}. Verifica tu SQL Server en el botón Servidor SQL.";
        }
        finally
        {
            isInitializingDb = false;
        }
    }

    private async Task IniciarSesion()
    {
        isLoading = true;
        ErrorMessage = null;

        var result = await AuthService.LoginAsync(Usuario, Clave);
        isLoading = false;

        if (result.Success)
        {
            if (AuthService.IsCajero)
            {
                Navigation.NavigateTo("pos", replace: true);
            }
            else
            {
                Navigation.NavigateTo("", replace: true);
            }
        }
        else
        {
            ErrorMessage = result.Message;
        }
    }

    private async Task OnConfigSaved()
    {
        await InitializeDatabaseIfNeeded();
    }
}
