@page "/promociones"
@inject IPromotionService PromotionService

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">Promociones & Banner de App Móvil</h4>
        <p class="text-muted small mb-0">Gestiona descuentos del catálogo y personaliza el banner publicitario que ven tus clientes en la App Móvil</p>
    </div>
    <button class="btn btn-success btn-sm px-3 fw-semibold" @onclick="NuevaPromocion">
        + Nueva Promoción
    </button>
</div>

@if (!string.IsNullOrEmpty(FeedbackMessage))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small mb-3">
        @FeedbackMessage
        <button type="button" class="btn-close py-2" @onclick="() => FeedbackMessage = null"></button>
    </div>
}

<!-- Panel de Personalización del Banner de la App Móvil (Solo Administrador ERP) -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success p-2 rounded-3">App Móvil</span>
                <div>
                    <h6 class="fw-bold mb-0">Banner Principal y Tema para Clientes</h6>
                    <small class="text-muted">Lo que configures aquí se mostrará automáticamente en la pantalla de inicio de todos tus clientes.</small>
                </div>
            </div>
            <button class="btn btn-primary btn-sm px-3 fw-semibold" @onclick="GuardarBannerAppMovil" disabled="@isSavingBanner">
                @(isSavingBanner ? "Publicando..." : "Publicar Banner en App Móvil")
            </button>
        </div>

        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Título del Banner</label>
                <input type="text" class="form-control form-control-sm" @bind="BannerTitulo" placeholder="Ej. ¡Ofertas de la Semana!" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Subtítulo / Mensaje para el Cliente</label>
                <input type="text" class="form-control form-control-sm" @bind="BannerSubtitulo" placeholder="Ej. Pide desde tu celular y paga en efectivo al recibir" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Etiqueta Destacada</label>
                <input type="text" class="form-control form-control-sm" @bind="BannerEtiqueta" placeholder="Ej. HASTA 20% OFF" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Color de la App Móvil</label>
                <select class="form-select form-select-sm" @bind="BannerTemaColor">
                    <option value="VERDE">Verde Esmeralda</option>
                    <option value="ROSA">Rosa Pedidos</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success"></div>
                <div class="mt-2 text-muted small">Cargando promociones...</div>
            </div>
        }
        else if (!ListaPromociones.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fw-semibold">No se registran promociones u ofertas configuradas</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre de la Oferta</th>
                            <th>Descuento</th>
                            <th>Alcance</th>
                            <th>Vigencia Desde</th>
                            <th>Vigencia Hasta</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width: 170px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ListaPromociones)
                        {
                            var esVigente = p.Estado && p.FechaInicio <= DateTime.Now && p.FechaFin >= DateTime.Now;
                            <tr>
                                <td class="fw-semibold">
                                    <div>@p.Nombre</div>
                                    @if (!string.IsNullOrEmpty(p.Descripcion))
                                    {
                                        <div class="text-muted text-truncate" style="max-width: 250px; font-size: 11px;">
                                            @p.Descripcion
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold fs-6">
                                        @(p.TipoDescuento == "Porcentaje" ? $"{p.Valor:F0}% OFF" : $"${p.Valor:F2} OFF")
                                    </span>
                                </td>
                                <td>
                                    @if (p.Producto != null)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @p.Producto.Nombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            Catálogo General
                                        </span>
                                    }
                                </td>
                                <td class="text-muted">@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td class="text-muted">@p.FechaFin.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    @if (!p.Estado)
                                    {
                                        <span class="badge bg-secondary">Inactiva</span>
                                    }
                                    else if (esVigente)
                                    {
                                        <span class="badge bg-success">● Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Vencida</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-outline-success btn-sm py-0 px-2 fw-semibold" 
                                                title="Editar" @onclick="() => Editar(p)">
                                            Editar
                                        </button>
                                        <button type="button" class="btn @(p.Estado ? "btn-outline-warning" : "btn-outline-success") btn-sm py-0 px-2 fw-semibold" 
                                                title="@(p.Estado ? "Pausar" : "Activar")" @onclick="() => ToggleEstado(p)">
                                            @(p.Estado ? "Pausar" : "Activar")
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-semibold" 
                                                title="Eliminar" @onclick="() => Eliminar(p)">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<PromoModal @bind-IsOpen="isModalOpen" PromocionEdit="@PromocionSeleccionada" OnSaved="CargarPromociones" />

@code {
    private List<Promocion> ListaPromociones = new();
    private bool isLoading = true;
    private bool isModalOpen;
    private Promocion? PromocionSeleccionada;
    private string? FeedbackMessage;
    private bool isSuccess;

    // Configuración del Banner de la App Móvil (guardada en BD mediante registro especial [APP_BANNER])
    private int BannerPromoId = 0;
    private string BannerTitulo = "¡Ofertas Especiales para Ti!";
    private string BannerSubtitulo = "Haz tu pedido desde tu celular y recíbelo rápido en la puerta de tu casa";
    private string BannerEtiqueta = "PROMOCIÓN";
    private string BannerTemaColor = "VERDE";
    private bool isSavingBanner = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarPromociones();
    }

    private async Task CargarPromociones()
    {
        isLoading = true;
        try
        {
            var todas = await PromotionService.GetAllAsync() ?? new();
            var bannerReg = todas.FirstOrDefault(x => x.Nombre != null && x.Nombre.StartsWith("[APP_BANNER]"));
            if (bannerReg != null)
            {
                BannerPromoId = bannerReg.IdPromocion;
                // Formato Descripción: Titulo || Subtitulo || Etiqueta || TemaColor
                var partes = (bannerReg.Descripcion ?? "").Split("||");
                if (partes.Length >= 1 && !string.IsNullOrWhiteSpace(partes[0])) BannerTitulo = partes[0].Trim();
                if (partes.Length >= 2 && !string.IsNullOrWhiteSpace(partes[1])) BannerSubtitulo = partes[1].Trim();
                if (partes.Length >= 3 && !string.IsNullOrWhiteSpace(partes[2])) BannerEtiqueta = partes[2].Trim();
                if (partes.Length >= 4 && !string.IsNullOrWhiteSpace(partes[3])) BannerTemaColor = partes[3].Trim();
            }

            ListaPromociones = todas
                .Where(x => x.Nombre == null || (!x.Nombre.StartsWith("[APP_BANNER]") && !x.Nombre.StartsWith("[ORD_")))
                .ToList();
        }
        catch (Exception ex)
        {
            ListaPromociones = new();
            FeedbackMessage = $"Error al cargar promociones: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarBannerAppMovil()
    {
        isSavingBanner = true;
        try
        {
            var promoBanner = new Promocion
            {
                IdPromocion = BannerPromoId,
                Nombre = "[APP_BANNER] Configuración App Móvil",
                Descripcion = $"{BannerTitulo.Trim()}||{BannerSubtitulo.Trim()}||{BannerEtiqueta.Trim()}||{BannerTemaColor.Trim()}",
                TipoDescuento = "MontoFijo",
                Valor = 0.01m,
                FechaInicio = DateTime.Today.AddDays(-1),
                FechaFin = DateTime.Today.AddYears(5),
                Estado = true,
                IdProducto = null
            };

            var res = await PromotionService.SaveAsync(promoBanner);
            isSuccess = res.Success;
            FeedbackMessage = res.Success
                ? "Banner y color de la App Móvil publicados exitosamente para todos los clientes."
                : res.Message;
            await CargarPromociones();
        }
        catch (Exception ex)
        {
            isSuccess = false;
            FeedbackMessage = $"Error al publicar banner: {ex.Message}";
        }
        finally
        {
            isSavingBanner = false;
        }
    }

    private void NuevaPromocion()
    {
        PromocionSeleccionada = null;
        isModalOpen = true;
    }

    private void Editar(Promocion p)
    {
        PromocionSeleccionada = p;
        isModalOpen = true;
    }

    private async Task ToggleEstado(Promocion p)
    {
        var result = await PromotionService.ToggleEstadoAsync(p.IdPromocion);
        isSuccess = result.Success;
        FeedbackMessage = result.Message;
        if (result.Success)
        {
            await CargarPromociones();
        }
    }

    private async Task Eliminar(Promocion p)
    {
        var result = await PromotionService.DeleteAsync(p.IdPromocion);
        isSuccess = result.Success;
        FeedbackMessage = result.Message;
        if (result.Success)
        {
            await CargarPromociones();
        }
    }
}
