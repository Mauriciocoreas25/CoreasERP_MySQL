@page "/cuentas-cobrar"
@inject ICreditService CreditService

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">Cuentas & Documentos por Cobrar</h4>
        <p class="text-muted small mb-0">Control de créditos a clientes, seguimiento de cartera y registro de abonos</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(FeedbackMessage))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small mb-3">
        @FeedbackMessage
        <button type="button" class="btn-close py-2" @onclick="() => FeedbackMessage = null"></button>
    </div>
}

<!-- Fila de Tarjetas Resumen de Cartera -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="kpi-card-clean">
            <div class="kpi-accent-bar"></div>
            <div class="kpi-number">$@TotalCartera.ToString("F2")</div>
            <div class="kpi-subtitle">Total en Créditos Emitidos</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="kpi-card-clean">
            <div class="kpi-accent-bar"></div>
            <div class="kpi-number text-success">$@TotalRecuperado.ToString("F2")</div>
            <div class="kpi-subtitle">Total Recuperado (Abonos)</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="kpi-card-clean">
            <div class="kpi-accent-bar" style="background-color: #dc2626;"></div>
            <div class="kpi-number text-danger">$@TotalPendienteCobro.ToString("F2")</div>
            <div class="kpi-subtitle">Saldo Pendiente por Cobrar</div>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm p-3 mb-4 bg-white rounded-3">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                </span>
                <input type="text" class="form-control" placeholder="Buscar por cliente o comprobante..." 
                       @bind="SearchTerm" @bind:event="oninput" @onkeyup="CargarCuentas" />
                @if (!string.IsNullOrEmpty(SearchTerm))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">&times;</button>
                }
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="btn-group btn-group-sm w-100" role="group">
                <button type="button" class="btn @(EstadoFiltro == "Todos" ? "btn-success" : "btn-outline-secondary")"
                        @onclick='() => FiltrarEstado("Todos")'>
                    Todas
                </button>
                <button type="button" class="btn @(EstadoFiltro == "Pendiente" ? "btn-success" : "btn-outline-secondary")"
                        @onclick='() => FiltrarEstado("Pendiente")'>
                    Pendientes
                </button>
                <button type="button" class="btn @(EstadoFiltro == "Pagada" ? "btn-success" : "btn-outline-secondary")"
                        @onclick='() => FiltrarEstado("Pagada")'>
                    Pagadas
                </button>
            </div>
        </div>

        <div class="col-12 col-md-3 text-md-end">
            <span class="badge bg-light text-secondary border small">
                Cuentas: @ListaCuentas.Count
            </span>
        </div>
    </div>
</div>

<!-- Tabla de Cuentas por Cobrar -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success"></div>
                <div class="mt-2 text-muted small">Cargando cuentas por cobrar...</div>
            </div>
        }
        else if (!ListaCuentas.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fw-semibold">No se registran cuentas por cobrar con los filtros seleccionados</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Comprobante</th>
                            <th>Fecha Emisión</th>
                            <th class="text-end">Monto Total</th>
                            <th class="text-end">Saldo Pendiente</th>
                            <th class="text-center">Abonos</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in ListaCuentas)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <div>@(c.Cliente?.Nombre ?? "Cliente")</div>
                                    <span class="text-muted" style="font-size: 10px;">
                                        @(c.Cliente?.NumDocumento ?? "")
                                    </span>
                                </td>
                                <td class="font-monospace text-success fw-bold">@(c.Venta?.NumComprobante ?? "-")</td>
                                <td class="text-muted">@c.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-semibold">$@c.MontoTotal.ToString("F2")</td>
                                <td class="text-end fw-bold @(c.SaldoPendiente > 0 ? "text-danger fs-6" : "text-success")">
                                    $@c.SaldoPendiente.ToString("F2")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @c.Abonos.Count abono(s)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(c.Estado == "Pagada" ? "badge-completed" : "badge-stock-low")">
                                        @c.Estado
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        @if (c.SaldoPendiente > 0)
                                        {
                                            <button type="button" class="btn btn-success btn-sm py-0 px-2 fw-semibold" 
                                                    title="Abonar" @onclick="() => AbrirAbono(c)">
                                                Abonar
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 fw-semibold" 
                                                title="Ver Detalle" @onclick="() => VerDetalle(c)">
                                            Ver
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<AbonoModal @bind-IsOpen="isAbonoModalOpen" Cuenta="@CuentaSeleccionada" OnSaved="OnAbonoRegistrado" />

<!-- Modal Detalle e Historial de Abonos -->
@if (isDetailModalOpen && CuentaSeleccionada != null)
{
    <div class="modal-backdrop-custom" @onclick="() => isDetailModalOpen = false">
        <div class="modal-content-custom large" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="mb-0 fw-bold">Historial de Abonos - @CuentaSeleccionada.Cliente?.Nombre</h6>
                </div>
                <button type="button" class="btn-close" @onclick="() => isDetailModalOpen = false"></button>
            </div>
            <div class="p-4">
                <div class="row g-2 p-3 bg-light rounded-3 small mb-3">
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Comprobante:</span>
                        <strong class="font-monospace">@(CuentaSeleccionada.Venta?.NumComprobante ?? "-")</strong>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Total Crédito:</span>
                        <strong>$@CuentaSeleccionada.MontoTotal.ToString("F2")</strong>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Saldo Pendiente:</span>
                        <strong class="text-danger">$@CuentaSeleccionada.SaldoPendiente.ToString("F2")</strong>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted d-block">Estado:</span>
                        <span class="badge @(CuentaSeleccionada.Estado == "Pagada" ? "badge-completed" : "badge-stock-low")">
                            @CuentaSeleccionada.Estado
                        </span>
                    </div>
                </div>

                <h6 class="fw-bold small mb-2">Abonos Realizados:</h6>
                @if (!CuentaSeleccionada.Abonos.Any())
                {
                    <div class="text-center py-3 text-muted small border rounded-2">
                        No hay abonos registrados para esta cuenta
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha y Hora</th>
                                    <th>Cajero / Usuario</th>
                                    <th>Método Pago</th>
                                    <th class="text-end">Monto Abonado</th>
                                    <th>Notas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ab in CuentaSeleccionada.Abonos.OrderByDescending(a => a.FechaHora))
                                {
                                    <tr>
                                        <td class="text-muted">@ab.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                                        <td>@(ab.Usuario?.Nombre ?? "-")</td>
                                        <td>@ab.MetodoPago</td>
                                        <td class="text-end fw-bold text-success">+$@ab.Monto.ToString("F2")</td>
                                        <td class="text-muted">@(ab.Notas ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="p-3 border-top bg-light d-flex justify-content-end">
                <button class="btn btn-secondary btn-sm" @onclick="() => isDetailModalOpen = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CuentaCobrar> ListaCuentas = new();
    private string SearchTerm = "";
    private string EstadoFiltro = "Todos";
    private bool isLoading = true;

    private bool isAbonoModalOpen;
    private bool isDetailModalOpen;
    private CuentaCobrar? CuentaSeleccionada;
    private string? FeedbackMessage;
    private bool isSuccess;

    private decimal TotalCartera => ListaCuentas.Sum(c => c.MontoTotal);
    private decimal TotalPendienteCobro => ListaCuentas.Sum(c => c.SaldoPendiente);
    private decimal TotalRecuperado => TotalCartera - TotalPendienteCobro;

    protected override async Task OnInitializedAsync()
    {
        await CargarCuentas();
    }

    private async Task CargarCuentas()
    {
        isLoading = true;
        try
        {
            ListaCuentas = await CreditService.GetCuentasAsync(SearchTerm, EstadoFiltro) ?? new();
        }
        catch (Exception ex)
        {
            ListaCuentas = new();
            FeedbackMessage = $"Error al cargar cuentas por cobrar: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LimpiarBusqueda()
    {
        SearchTerm = "";
        await CargarCuentas();
    }

    private async Task FiltrarEstado(string estado)
    {
        EstadoFiltro = estado;
        await CargarCuentas();
    }

    private void AbrirAbono(CuentaCobrar c)
    {
        CuentaSeleccionada = c;
        isAbonoModalOpen = true;
    }

    private async Task VerDetalle(CuentaCobrar c)
    {
        CuentaSeleccionada = await CreditService.GetCuentaByIdAsync(c.IdCuentaCobrar);
        isDetailModalOpen = true;
    }

    private async Task OnAbonoRegistrado()
    {
        isSuccess = true;
        FeedbackMessage = "¡Abono registrado con éxito!";
        await CargarCuentas();
    }
}
