@inject IJSRuntime JSRuntime
@inject IPrintService PrintService
@inject IDbContextFactory<AppDbContext> ContextFactory
@using CoreasERP.Data
@using Microsoft.EntityFrameworkCore

@if (IsOpen)
{
    <div class="modal-backdrop-custom" tabindex="-1" style="z-index: 1070;" @onclick="Cerrar">
        <div class="modal-content-custom" style="max-width: 960px; width: 95%; max-height: 92vh; display: flex; flex-direction: column;" @onclick:stopPropagation="true">
            
            <!-- Cabecera del Modal -->
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center text-white"
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <div class="d-flex align-items-center gap-2">
                    <div>
                        <h6 class="mb-0 fw-bold text-white">Centro de Impresión de Precios & Banderines</h6>
                        <small class="text-slate-300" style="font-size: 11px; opacity: 0.85;">
                            Generación inteligente: Impresora Térmica (58mm/80mm), Flejes de estante y Banderines tipo Walmart
                        </small>
                    </div>
                </div>
                <button type="button" class="btn btn-sm text-white-50 p-0 border-0 bg-transparent fs-5 lh-1" 
                        style="cursor: pointer;" @onclick="Cerrar" title="Cerrar">&times;</button>
            </div>

            <!-- Barra de Pestañas de Clasificación -->
            <div class="px-3 pt-2 bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="nav nav-tabs border-0 gap-2">
                    <button type="button" 
                            class="nav-link border-0 fw-bold px-3 py-2 small @(ActiveTab == "walmart" ? "active bg-white text-danger border-bottom border-3 border-danger shadow-sm" : "text-muted")"
                            @onclick='() => ActiveTab = "walmart"'>
                        Banderines de Rebaja Walmart
                        <span class="badge rounded-pill bg-danger ms-1" style="font-size: 11px;">@ItemsWalmart.Count</span>
                    </button>
                    <button type="button" 
                            class="nav-link border-0 fw-bold px-3 py-2 small @(ActiveTab == "shelf" ? "active bg-white text-success border-bottom border-3 border-success shadow-sm" : "text-muted")"
                            @onclick='() => ActiveTab = "shelf"'>
                        Flejes de Estante
                        <span class="badge rounded-pill bg-secondary ms-1" style="font-size: 11px;">@ItemsShelf.Count</span>
                    </button>
                    <button type="button" 
                            class="nav-link border-0 fw-bold px-3 py-2 small @(ActiveTab == "thermal" ? "active bg-white text-dark border-bottom border-3 border-dark shadow-sm" : "text-muted")"
                            @onclick='() => ActiveTab = "thermal"'>
                        Rollo Térmico (58/80mm)
                        <span class="badge rounded-pill bg-dark ms-1" style="font-size: 11px;">@ItemsParaImprimir.Count</span>
                    </button>
                </div>

                <!-- Botones de Disparo de Impresión -->
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-dark btn-sm px-3 fw-bold shadow-sm d-flex align-items-center gap-2"
                            disabled="@(!ItemsParaImprimir.Any() || isPrintingThermal)"
                            @onclick="ImprimirTermica" title="Imprimir directamente en el rollo de la impresora térmica configurada">
                        @if (isPrintingThermal)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Imprimiendo en Térmica...</span>
                        }
                        else
                        {
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                            <span>Imprimir en Térmica (@ItemsParaImprimir.Count)</span>
                        }
                    </button>

                    @if (ActiveTab == "walmart")
                    {
                        <button type="button" class="btn btn-danger btn-sm px-3 fw-bold shadow-sm d-flex align-items-center gap-2"
                                disabled="@(!ItemsWalmart.Any() || isPrinting)"
                                @onclick="ImprimirWalmart">
                            @if (isPrinting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Preparando...</span>
                            }
                            else
                            {
                                <span>Imprimir Hojas Carta</span>
                            }
                        </button>
                    }
                    else if (ActiveTab == "shelf")
                    {
                        <button type="button" class="btn btn-success btn-sm px-3 fw-bold shadow-sm d-flex align-items-center gap-2"
                                style="background-color: #15803d; border-color: #15803d;"
                                disabled="@(!ItemsShelf.Any() || isPrinting)"
                                @onclick="ImprimirShelf">
                            @if (isPrinting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Preparando...</span>
                            }
                            else
                            {
                                <span>Imprimir Hojas Carta</span>
                            }
                        </button>
                    }
                </div>
            </div>

            <!-- Cuerpo del Modal: Previsualización en Vivo de las Hojas -->
            <div class="p-3 overflow-auto flex-grow-1" style="background-color: #f1f5f9; min-height: 420px;">
                
                @if (ActiveTab == "walmart")
                {
                    <!-- PESTAÑA BANDERINES WALMART -->
                    @if (!ItemsWalmart.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <div class="mb-2 text-muted">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                            </div>
                            <div class="fw-bold">No hay productos con rebaja del 10% o más en esta selección.</div>
                            <small>Los artículos con alzas o variaciones leves se encuentran en la pestaña "Flejes de Estante".</small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center justify-content-between mb-3 rounded-3 border-0 bg-danger bg-opacity-10 text-danger">
                            <div>
                                <strong>Formato de Impresión:</strong> Hoja Carta Horizontal (Landscape) • <strong>6 banderines por hoja (cuadrícula 3x2)</strong>.
                            </div>
                            <span class="badge bg-danger">Total: @TotalPaginasWalmart @(TotalPaginasWalmart == 1 ? "Hoja" : "Hojas")</span>
                        </div>

                        <!-- Contenedor Imprimible Walmart -->
                        <div id="printable-walmart-content">
                            @for (int p = 0; p < PaginasWalmart.Count; p++)
                            {
                                int pageNum = p + 1;
                                var pageItems = PaginasWalmart[p];

                                <div class="print-page mb-4 p-3 bg-white border rounded shadow-sm" style="max-width: 900px; margin: 0 auto;">
                                    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom text-muted no-print" style="font-size: 11px;">
                                        <span>Hoja Carta Horizontal - Página @pageNum de @TotalPaginasWalmart</span>
                                        <span>COREAS ERP • Banderines de Rebaja Tipo Walmart (6 por hoja)</span>
                                    </div>

                                    <div class="walmart-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                                        @foreach (var item in pageItems)
                                        {
                                            decimal pct = CalcularDescuentoPorcentaje(item);
                                            decimal ahorro = Math.Max(0, item.PrecioVentaAnterior - item.PrecioVentaNuevo);

                                            <div class="walmart-banner-card border-danger border-2 rounded-3 shadow-sm bg-white overflow-hidden d-flex flex-column"
                                                 style="border-style: dashed; min-height: 205px; border-width: 2px;">
                                                
                                                <!-- Cabecera roja con medalla de rebaja -->
                                                <div class="bg-danger text-white p-2 d-flex justify-content-between align-items-center"
                                                     style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);">
                                                    <div class="fw-black text-uppercase" style="font-size: 13px; letter-spacing: 0.5px;">
                                                        ¡GRAN REBAJA!
                                                    </div>
                                                    <span class="badge bg-warning text-dark fw-bold" style="font-size: 12px;">
                                                        -@pct.ToString("0")%
                                                    </span>
                                                </div>

                                                <!-- Cuerpo del Banderín -->
                                                <div class="p-2 d-flex flex-column justify-content-between flex-grow-1">
                                                    <div>
                                                        <div class="text-truncate fw-bold text-dark mb-1" title="@(item.Producto?.Nombre)" style="font-size: 13px; line-height: 1.2;">
                                                            @(item.Producto?.Nombre ?? "Artículo")
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center small text-muted" style="font-size: 10px;">
                                                            <span class="font-monospace">SKU: @(item.Producto?.Codigo)</span>
                                                            <span class="text-truncate" style="max-width: 90px;">@(item.Producto?.Categoria?.Nombre ?? "General")</span>
                                                        </div>
                                                    </div>

                                                    <!-- Comparación de Precios de Alto Impacto -->
                                                    <div class="my-2 p-1 text-center rounded bg-light border">
                                                        <div class="d-flex justify-content-around align-items-center">
                                                            <div>
                                                                <div class="text-muted text-uppercase" style="font-size: 9px; font-weight: 600;">Antes</div>
                                                                <div class="text-muted text-decoration-line-through fw-bold" style="font-size: 13px;">
                                                                    $@item.PrecioVentaAnterior.ToString("F2")
                                                                </div>
                                                            </div>
                                                            <div class="text-danger fs-5">&rarr;</div>
                                                            <div>
                                                                <div class="text-danger text-uppercase fw-bold" style="font-size: 10px;">Ahora</div>
                                                                <div class="text-danger fw-bolder" style="font-size: 24px; line-height: 1;">
                                                                    $@item.PrecioVentaNuevo.ToString("F2")
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="badge bg-success text-white w-100 mt-1 py-1" style="font-size: 10.5px;">
                                                            ¡Ahorras $@ahorro.ToString("F2") (-@pct.ToString("0")%)!
                                                        </div>
                                                    </div>

                                                    <!-- Código de barras simulado y guía de corte -->
                                                    <div class="text-center pt-1 border-top">
                                                        <div style="background: repeating-linear-gradient(to right, #000 0, #000 2px, #fff 2px, #fff 4px, #000 4px, #000 7px, #fff 7px, #fff 9px, #000 9px, #000 10px, #fff 10px, #fff 13px); height: 18px; width: 130px; margin: 0 auto;"></div>
                                                        <div class="font-monospace text-muted mt-1" style="font-size: 9px;">
                                                            @(item.Producto?.Codigo) • Recortar por línea punteada
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <!-- PESTAÑA FLEJES DE ESTANTE DE SUPERMERCADO -->
                    @if (!ItemsShelf.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <div class="mb-2 text-muted">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                            </div>
                            <div class="fw-bold">No hay artículos para etiquetas estándar de estante en esta selección.</div>
                            <small>Todos los artículos seleccionados corresponden a rebajas ≥ 10% y se encuentran en la pestaña "Banderines Walmart".</small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-primary py-2 px-3 small d-flex align-items-center justify-content-between mb-3 rounded-3 border-0 bg-success bg-opacity-10 text-success">
                            <div>
                                <strong>Formato de Impresión:</strong> Etiquetas compactas de estante / flejes de góndola (Alzas y variaciones estándar).
                            </div>
                            <span class="badge bg-success">Total: @ItemsShelf.Count Etiquetas</span>
                        </div>

                        <!-- Contenedor Imprimible Shelf -->
                        <div id="printable-shelf-content">
                            <div class="print-page p-3 bg-white border rounded shadow-sm" style="max-width: 860px; margin: 0 auto;">
                                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom text-muted no-print" style="font-size: 11px;">
                                    <span>Etiquetas de Estante de Supermercado</span>
                                    <span>COREAS ERP • Flejes de Góndola</span>
                                </div>

                                <div class="shelf-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                                    @foreach (var item in ItemsShelf)
                                    {
                                        <div class="shelf-card border rounded p-2 bg-white d-flex flex-column justify-content-between shadow-sm"
                                             style="border: 1px dashed #64748b !important; height: 145px;">
                                            
                                            <!-- Marca y Categoría -->
                                            <div class="d-flex justify-content-between align-items-center text-muted border-bottom pb-1" style="font-size: 9.5px;">
                                                <strong class="text-dark">COREAS ERP</strong>
                                                <span class="text-truncate" style="max-width: 110px;">@(item.Producto?.Categoria?.Nombre ?? "Almacén")</span>
                                            </div>

                                            <!-- Nombre de Producto -->
                                            <div class="my-1">
                                                <div class="fw-bold text-dark text-truncate" title="@(item.Producto?.Nombre)" style="font-size: 12px; line-height: 1.2;">
                                                    @(item.Producto?.Nombre ?? "Producto")
                                                </div>
                                                <div class="text-muted font-monospace" style="font-size: 9px;">
                                                    SKU: @(item.Producto?.Codigo)
                                                </div>
                                            </div>

                                            <!-- Precio Destacado -->
                                            <div class="d-flex justify-content-between align-items-end my-1">
                                                <div>
                                                    <div style="background: repeating-linear-gradient(to right, #000 0, #000 2px, #fff 2px, #fff 4px, #000 4px, #000 7px, #fff 7px, #fff 9px, #000 9px, #000 10px, #fff 10px, #fff 13px); height: 16px; width: 95px;"></div>
                                                    <span class="text-muted font-monospace" style="font-size: 8.5px;">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                                                </div>
                                                <div class="text-end">
                                                    <span class="fs-4 fw-black text-dark" style="font-weight: 900; line-height: 1;">
                                                        $@item.PrecioVentaNuevo.ToString("F2")
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Línea de corte -->
                                            <div class="border-top pt-1 text-center text-muted" style="font-size: 8px;">
                                                Corte perimetral fleje
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (ActiveTab == "thermal")
                {
                    <!-- PESTAÑA ROLLO TÉRMICO POS -->
                    <div class="d-flex flex-column align-items-center py-2">
                        <div class="alert alert-dark py-2 px-3 small d-flex align-items-center justify-content-between mb-3 rounded-3 border-0 bg-dark text-white w-100" style="max-width: 380px;">
                            <div>
                                <strong>Formato Térmico:</strong> Rollo continuo POS (58mm / 80mm) con guías de corte.
                            </div>
                            <span class="badge bg-warning text-dark">@ItemsParaImprimir.Count Etiquetas</span>
                        </div>

                        @if (!string.IsNullOrEmpty(thermalStatusMessage))
                        {
                            <div class="alert @(thermalStatusIsError ? "alert-danger" : "alert-success") py-2 px-3 small w-100 mb-3 text-center" style="max-width: 380px;">
                                @thermalStatusMessage
                            </div>
                        }

                        <!-- Vista previa del rollo de papel continuo -->
                        <div class="thermal-strip bg-white border rounded shadow p-3 font-monospace" style="width: 100%; max-width: 340px;">
                            @foreach (var item in ItemsParaImprimir)
                            {
                                bool esRebaja = EsRebajaMayorOIgual10Porciento(item);
                                decimal diff = item.PrecioVentaAnterior - item.PrecioVentaNuevo;
                                decimal pct = esRebaja ? CalcularDescuentoPorcentaje(item) : 0m;

                                <div class="thermal-tag-preview text-center py-2 mb-2 border-bottom">
                                    @if (esRebaja)
                                    {
                                        <div class="fw-bold text-danger" style="font-size: 13px;">*** ¡GRAN REBAJA! ***</div>
                                        <div class="small fw-semibold text-success">¡Ahorras $@diff.ToString("F2") (-@pct.ToString("0")%)!</div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark" style="font-size: 13px;">*** ETIQUETA DE PRECIO ***</div>
                                        <div class="small text-muted">COREAS ERP</div>
                                    }

                                    <div class="fw-bold fs-6 my-1 text-dark" style="line-height: 1.2;">
                                        @(item.Producto?.Nombre ?? "Producto")
                                    </div>

                                    <div class="d-flex justify-content-between text-muted small" style="font-size: 11px;">
                                        <span>SKU: @(item.Producto?.Codigo ?? "-")</span>
                                        <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                                    </div>

                                    @if (esRebaja)
                                    {
                                        <div class="text-muted text-decoration-line-through small mt-1">
                                            Antes: $@item.PrecioVentaAnterior.ToString("F2")
                                        </div>
                                        <div class="fs-4 fw-bolder text-danger">
                                            $@item.PrecioVentaNuevo.ToString("F2")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fs-4 fw-bolder text-dark mt-1">
                                            $@item.PrecioVentaNuevo.ToString("F2")
                                        </div>
                                    }

                                    <div class="text-muted text-center mt-2 small" style="letter-spacing: 1px; font-size: 10px;">
                                        - - - [ CORTAR FLEJE ] - - -
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>

            <!-- Pie del Modal -->
            <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    La impresión en hojas carta utiliza la vista de impresión del sistema; la impresión térmica envía directamente a la impresora predeterminada.
                </span>
                <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="Cerrar">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public List<CambioPrecio> ItemsParaImprimir { get; set; } = new();

    private string ActiveTab = "walmart";
    private bool isPrinting = false;
    private bool isPrintingThermal = false;
    private string? thermalStatusMessage = null;
    private bool thermalStatusIsError = false;

    private List<CambioPrecio> ItemsWalmart = new();
    private List<CambioPrecio> ItemsShelf = new();
    private List<List<CambioPrecio>> PaginasWalmart = new();
    private int TotalPaginasWalmart => PaginasWalmart.Count;

    protected override void OnParametersSet()
    {
        if (IsOpen && ItemsParaImprimir != null)
        {
            thermalStatusMessage = null;
            thermalStatusIsError = false;

            // Separar automáticamente los artículos:
            // Variación a la baja >= 10% -> Banderín Walmart (6 por hoja horizontal)
            // Variación al alza o baja < 10% -> Fleje de estante
            ItemsWalmart = ItemsParaImprimir
                .Where(i => EsRebajaMayorOIgual10Porciento(i))
                .ToList();

            ItemsShelf = ItemsParaImprimir
                .Where(i => !EsRebajaMayorOIgual10Porciento(i))
                .ToList();

            // Dividir los banderines de Walmart exactamente a 6 por página
            PaginasWalmart = ItemsWalmart
                .Chunk(6)
                .Select(c => c.ToList())
                .ToList();

            // Seleccionar automáticamente la pestaña con contenido
            if (ItemsWalmart.Any())
            {
                ActiveTab = "walmart";
            }
            else
            {
                ActiveTab = "shelf";
            }
        }
    }

    private bool EsRebajaMayorOIgual10Porciento(CambioPrecio c)
    {
        if (c.PrecioVentaAnterior <= 0) return false;
        if (c.PrecioVentaNuevo >= c.PrecioVentaAnterior) return false; // Alza o sin cambio

        decimal diff = c.PrecioVentaAnterior - c.PrecioVentaNuevo;
        decimal pct = (diff / c.PrecioVentaAnterior) * 100m;
        return pct >= 10.0m;
    }

    private decimal CalcularDescuentoPorcentaje(CambioPrecio c)
    {
        if (c.PrecioVentaAnterior <= 0) return 0;
        decimal diff = c.PrecioVentaAnterior - c.PrecioVentaNuevo;
        if (diff <= 0) return 0;
        return Math.Round((diff / c.PrecioVentaAnterior) * 100m, 1);
    }

    private async Task ImprimirWalmart()
    {
        if (!ItemsWalmart.Any()) return;
        isPrinting = true;
        try
        {
            await PrintService.PrintPriceTagsAsync(JSRuntime, "printable-walmart-content", "landscape");
        }
        finally
        {
            isPrinting = false;
        }
    }

    private async Task ImprimirShelf()
    {
        if (!ItemsShelf.Any()) return;
        isPrinting = true;
        try
        {
            await PrintService.PrintPriceTagsAsync(JSRuntime, "printable-shelf-content", "portrait");
        }
        finally
        {
            isPrinting = false;
        }
    }

    private async Task ImprimirTermica()
    {
        if (!ItemsParaImprimir.Any()) return;
        isPrintingThermal = true;
        thermalStatusMessage = null;
        try
        {
            await using var ctx = await ContextFactory.CreateDbContextAsync();
            var cfg = await ctx.ConfiguracionNegocio.FirstOrDefaultAsync();
            var res = await PrintService.PrintPriceTagsDirectAsync(ItemsParaImprimir, cfg);
            thermalStatusIsError = !res.Success;
            thermalStatusMessage = res.Message;
        }
        catch (Exception ex)
        {
            thermalStatusIsError = true;
            thermalStatusMessage = $"Error al imprimir etiquetas térmicas: {ex.Message}";
        }
        finally
        {
            isPrintingThermal = false;
            StateHasChanged();
        }
    }

    private async Task Cerrar()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
