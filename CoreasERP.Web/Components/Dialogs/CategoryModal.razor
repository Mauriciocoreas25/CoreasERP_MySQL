@inject ICategoryService CategoryService

@if (IsOpen)
{
    <div class="modal-backdrop-custom" @onclick="Close">
        <div class="modal-content-custom" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="mb-0 fw-bold">@(Model.IdCategoria == 0 ? "Nueva Categoría" : "Editar Categoría")</h6>
                </div>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <div class="p-4">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Nombre de la Categoría *</label>
                    <input type="text" class="form-control" @bind="Model.Nombre" placeholder="Ej. Bebidas y Snacks" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Descripción (Opcional)</label>
                    <textarea class="form-control" rows="3" @bind="Model.Descripcion" placeholder="Detalle de los productos que agrupa esta categoría"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger py-2 small mb-0">
                        @ErrorMessage
                    </div>
                }
            </div>

            <div class="p-3 border-top bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm px-3 fw-semibold" style="background-color: #15803d; border-color: #15803d;" @onclick="Guardar" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Categoría</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public CategoriaDto? CategoriaEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private Categoria Model = new();
    private bool isSaving;
    private string? ErrorMessage;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            if (CategoriaEdit != null && CategoriaEdit.IdCategoria > 0)
            {
                Model = new Categoria
                {
                    IdCategoria = CategoriaEdit.IdCategoria,
                    Nombre = CategoriaEdit.Nombre,
                    Descripcion = CategoriaEdit.Descripcion
                };
            }
            else
            {
                Model = new Categoria();
            }
            ErrorMessage = null;
            isSaving = false;
        }
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(Model.Nombre))
        {
            ErrorMessage = "El nombre de la categoría es obligatorio.";
            return;
        }

        isSaving = true;
        ErrorMessage = null;

        var result = await CategoryService.SaveAsync(Model);
        isSaving = false;

        if (result.Success)
        {
            await Close();
            await OnSaved.InvokeAsync();
        }
        else
        {
            ErrorMessage = result.Message;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
