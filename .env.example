# ==============================================================================
# PLANTILLA DE CONFIGURACION PARA DESPLIEGUES DE CLIENTES (CoreasERP)
# Copia este archivo como ".env" (en la raiz del proyecto o en C:\CoreasERP\.env)
# El archivo ".env" esta ignorado en .gitignore para que nunca se suba a GitHub.
# ==============================================================================

# 1. MODO DE CONEXION DE LA APP DE ESCRITORIO
# true  = Conecta mediante la API en la nube (recomendado para clientes multi-sucursal / app movil)
# false = Conecta directo al motor MySQL (local o remoto)
USE_API_MODE=true

# 2. URL DE LA API DEL CLIENTE (MonsterASP / RunASP / VPS / Local)
API_BASE_URL=http://coreaserp.runasp.net

# 3. CREDENCIALES MYSQL DEL CLIENTE (Puedes usar los campos separados o MYSQL_CONNECTION_STRING completo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Coreas_ERP
DB_USER=root
DB_PASSWORD=tu_password_aqui

# Opcional: Cadena de conexion completa (si se deja vacia, se arma automaticamente con los campos DB_ de arriba)
MYSQL_CONNECTION_STRING=
